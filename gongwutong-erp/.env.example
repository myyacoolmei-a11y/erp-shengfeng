# 工務通 ERP — 獨立環境，禁止連到晟風 production database
#
# 本系統必須使用自己的 PostgreSQL。不要填入 shengfeng_erp 或晟風 Railway DATABASE_URL。

DATABASE_URL=postgresql://gongwutong:gongwutong@localhost:5432/gongwutong_erp

# 獨立 port，避免與晟風本機 3000 衝突
PORT=3100

NODE_ENV=development

# 獨立 JWT，不可沿用晟風正式環境密鑰
JWT_SECRET=gongwutong-dev-change-before-production

APP_NAME=工務通 ERP
APP_URL=http://localhost:3100
PUBLIC_APP_URL=http://localhost:3100
APP_BASE_URL=http://localhost:3100

OPENAI_API_KEY=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
CRON_SECRET=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
